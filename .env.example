# Copy to .env.local (git-ignored) and adjust. Values here are compiled into the app and are
# public: never put a secret in an EXPO_PUBLIC_ variable.
#
# The backend origin, with no trailing slash. The iOS simulator can reach the Mac's localhost.
# A physical device needs the Mac's LAN address instead, for example http://192.168.1.20:4000.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
